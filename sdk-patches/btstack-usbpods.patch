+/* The AG is mid-response (actively segmenting an SLC reply) in these states.
+   ->command is NOT reset during segmentation, so gate the pipeline drain on
+   STATE, not command (the original command-based guard never fired -> CIND?
+   was replayed at the wrong moment -> the "+CIND answered 4x, SLC stalls"
+   bug with PipeWire's batched AT commands). */
+static bool hfp_ag_slc_response_in_flight(const hfp_connection_t * c){
+    switch (c->state){
+        case HFP_RETRIEVE_INDICATORS:
+        case HFP_RETRIEVE_INDICATORS_STATUS:
+        case HFP_ENABLE_INDICATORS_STATUS_UPDATE:
+        case HFP_RETRIEVE_CAN_HOLD_CALL:
+        case HFP_LIST_GENERIC_STATUS_INDICATORS:
+        case HFP_RETRIEVE_GENERIC_STATUS_INDICATORS:
+        case HFP_RETRIEVE_INITITAL_STATE_GENERIC_STATUS_INDICATORS:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/* Drain one parked pipelined command once the AG is idle (not mid-response).
+   Returns true if bytes were processed (caller should run the context). */
+static bool hfp_ag_drain_pending_rx(hfp_connection_t * hfp_connection){
+    if (hfp_connection->ag_rx_pending_len == 0) return false;
+    if (hfp_ag_slc_response_in_flight(hfp_connection)){
+        /* still segmenting the previous reply — retry on the next slot */
+        rfcomm_request_can_send_now_event(hfp_connection->rfcomm_cid);
+        return false;
+    }
+    uint8_t tmp[sizeof(hfp_connection->ag_rx_pending)];
+    uint8_t n = hfp_connection->ag_rx_pending_len;
+    (void)memcpy(tmp, hfp_connection->ag_rx_pending, n);
+    hfp_connection->ag_rx_pending_len = 0;
+    hfp_ag_handle_rfcomm_data(hfp_connection, tmp, n);   /* may re-park */
+    return true;
+}
